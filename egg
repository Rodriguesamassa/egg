local key=[[-- "Roube um ovo"  local Players = game:GetService("Players") local RunService = game:GetService("RunService") local UserInputService = game:GetService("UserInputService") local TweenService = game:GetService("TweenService") local Lighting = game:GetService("Lighting") local TeleportService = game:GetService("TeleportService") local HttpService = game:GetService("HttpService") local LocalPlayer = Players.LocalPlayer local Camera = workspace.CurrentCamera  -- [[ Função de Notificação Simples ]] local function notify(title, text)     pcall(function()         game:GetService("StarterGui"):SetCore("SendNotification", {             Title = title,             Text = text,             Duration = 3         })     end) end  -- [[ Estado Global / Configurações ]] getgenv().EggScriptConfig = {     Combat = {         HitboxEnabled = false,         HitboxSize = 5,         HitboxTransparency = 0.5,         HeadSizeEnabled = false,         HeadSize = 2,         FlyEnabled = false,         FlySpeed = 50,         NoClipEnabled = false     },     AutoFarm = {         Active = false,         Delay = 0.5,         SelectedArea = "Automático (Melhor Área)"     },     ESP = {         PlayersEnabled = false,         Box = false,         Name = false,         Tracer = false     },     Settings = {         AntiAFKEnabled = false,         AntiLagEnabled = false     } }  -- [[ Lógica de Fly com Bypass & NoClip ]] local bv, bg  local function updateFly()     local char = LocalPlayer.Character     local hrp = char and char:FindFirstChild("HumanoidRootPart")     local hum = char and char:FindFirstChildOfClass("Humanoid")          if EggScriptConfig.Combat.FlyEnabled and hrp and hum then         hum.PlatformStand = true         if not hrp:FindFirstChild("EggFlyVelocity") then             bv = Instance.new("BodyVelocity")             bv.Name = "EggFlyVelocity"             bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)             bv.Velocity = Vector3.new(0, 0, 0)             bv.Parent = hrp                          bg = Instance.new("BodyGyro")             bg.Name = "EggFlyGyro"             bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)             bg.P = 9000             bg.Parent = hrp         end     else         if hrp then             if hrp:FindFirstChild("EggFlyVelocity") then hrp.EggFlyVelocity:Destroy() end             if hrp:FindFirstChild("EggFlyGyro") then hrp.EggFlyGyro:Destroy() end         end         if hum then             hum.PlatformStand = false         end     end end  RunService.RenderStepped:Connect(function()     local char = LocalPlayer.Character     local hrp = char and char:FindFirstChild("HumanoidRootPart")     local hum = char and char:FindFirstChildOfClass("Humanoid")          -- NoClip Loop     if EggScriptConfig.Combat.NoClipEnabled and char then         for _, part in ipairs(char:GetDescendants()) do             if part:IsA("BasePart") then                 part.CanCollide = false             end         end     end          -- Fly Loop     if EggScriptConfig.Combat.FlyEnabled and hrp and hum and hrp:FindFirstChild("EggFlyVelocity") then         local camCFrame = Camera.CFrame         local moveDir = Vector3.new(0, 0, 0)                  if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then             moveDir += camCFrame.LookVector         end         if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then             moveDir -= camCFrame.LookVector         end         if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then             moveDir -= camCFrame.RightVector         end         if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then             moveDir += camCFrame.RightVector         end         if UserInputService:IsKeyDown(Enum.KeyCode.Space) then             moveDir += Vector3.new(0, 1, 0)         end         if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then             moveDir -= Vector3.new(0, 1, 0)         end                  hrp.EggFlyVelocity.Velocity = moveDir * EggScriptConfig.Combat.FlySpeed         hrp.EggFlyGyro.CFrame = camCFrame         hum.PlatformStand = true     end end)  LocalPlayer.CharacterAdded:Connect(function()     if EggScriptConfig.Combat.FlyEnabled then         EggScriptConfig.Combat.FlyEnabled = false         task.wait(1)     end end)  -- [[ Função de Servidor Vazio Otimizada (Evita Erro 772) ]] local function hopLowServer()     pcall(function()         notify("Servidor", "Procurando um servidor com vagas livres...")                  local placeId = game.PlaceId         local servers = {}         local cursor = ""                  repeat             local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"             if cursor ~= "" and cursor ~= nil then                 url = url .. "&cursor=" .. cursor             end                          local success, rawResult = pcall(function()                 return game:HttpGet(url)             end)                          if success and rawResult then                 local decodeSuccess, result = pcall(function()                     return HttpService:JSONDecode(rawResult)                 end)                                  if decodeSuccess and result and result.data then                     for _, server in ipairs(result.data) do                         if type(server) == "table" and server.id and server.playing and server.maxPlayers then                             if server.id ~= game.JobId and server.playing <= (server.maxPlayers - 2) then                                 table.insert(servers, server)                             end                         end                     end                     cursor = result.nextPageCursor                 else                     break                 end             else                 break             end         until cursor == nil or cursor == "" or #servers >= 100          table.sort(servers, function(a, b)             return a.playing < b.playing         end)          if #servers > 0 then             local teleportsTried = 0             for _, targetServer in ipairs(servers) do                 teleportsTried += 1                 if teleportsTried > 3 then break end                                  notify("Servidor", "Entrando no servidor (Jogadores: " .. targetServer.playing .. ")...")                 local tpSuccess = pcall(function()                     TeleportService:TeleportToPlaceInstance(placeId, targetServer.id, LocalPlayer)                 end)                                  if tpSuccess then                     task.wait(2)                 end             end         else             notify("Servidor", "Nenhum servidor ideal encontrado, tentando teleporte aleatório...")             TeleportService:Teleport(placeId, LocalPlayer)         end     end) end  -- [[ Armazenamento de Valores Originais para Reset (Hitbox e Cabeça) ]] local originalPlayerSizes = {}  local function storeOriginals(player)     if player and player.Character then         local hrp = player.Character:FindFirstChild("HumanoidRootPart")         local head = player.Character:FindFirstChild("Head")         if not originalPlayerSizes[player] then             originalPlayerSizes[player] = {}         end         if hrp and not originalPlayerSizes[player].HrpSize then             originalPlayerSizes[player].HrpSize = hrp.Size             originalPlayerSizes[player].HrpTrans = hrp.Transparency         end         if head and not originalPlayerSizes[player].HeadSize then             originalPlayerSizes[player].HeadSize = head.Size             originalPlayerSizes[player].HeadTrans = head.Transparency         end     end end  Players.PlayerRemoving:Connect(function(player)     originalPlayerSizes[player] = nil end)  -- [[ Lógica do Hitbox Corrigida (RenderStepped contínuo) ]] RunService.RenderStepped:Connect(function()     for _, player in ipairs(Players:GetPlayers()) do         if player ~= LocalPlayer and player.Character then             local hrp = player.Character:FindFirstChild("HumanoidRootPart")             if hrp then                 storeOriginals(player)                 if EggScriptConfig.Combat.HitboxEnabled then                     hrp.Size = Vector3.new(EggScriptConfig.Combat.HitboxSize, EggScriptConfig.Combat.HitboxSize, EggScriptConfig.Combat.HitboxSize)                     hrp.Transparency = EggScriptConfig.Combat.HitboxTransparency                     hrp.CanCollide = false                 else                     if originalPlayerSizes[player] and originalPlayerSizes[player].HrpSize then                         hrp.Size = originalPlayerSizes[player].HrpSize                         hrp.Transparency = originalPlayerSizes[player].HrpTrans or 1                         hrp.CanCollide = true                     end                 end             end         end     end end)  -- [[ Lógica de Aumentar a Cabeça Corrigida (RenderStepped contínuo) ]] RunService.RenderStepped:Connect(function()     for _, player in ipairs(Players:GetPlayers()) do         if player ~= LocalPlayer and player.Character then             local head = player.Character:FindFirstChild("Head")             if head then                 storeOriginals(player)                 if EggScriptConfig.Combat.HeadSizeEnabled then                     local scale = EggScriptConfig.Combat.HeadSize                     head.Size = Vector3.new(scale * 2, scale * 2, scale * 2)                     head.CanCollide = false                 else                     if originalPlayerSizes[player] and originalPlayerSizes[player].HeadSize then                         head.Size = originalPlayerSizes[player].HeadSize                         head.CanCollide = true                     end                 end             end         end     end end)  -- [[ Sistema de ESP (Players) ]] local espDrawings = {}  local function createPlayerESP(player)     if espDrawings[player] then return end          local drawings = {         Box = Drawing.new("Square"),         Name = Drawing.new("Text"),         Tracer = Drawing.new("Line")     }          drawings.Box.Visible = false     drawings.Box.Filled = false     drawings.Box.Thickness = 1.5     drawings.Box.Color = Color3.fromRGB(255, 255, 255)      drawings.Name.Visible = false     drawings.Name.Size = 14     drawings.Name.Center = true     drawings.Name.Outline = true     drawings.Name.Color = Color3.fromRGB(255, 255, 255)      drawings.Tracer.Visible = false     drawings.Tracer.Thickness = 1     drawings.Tracer.Color = Color3.fromRGB(255, 255, 255)          espDrawings[player] = drawings end  local function removePlayerESP(player)     if espDrawings[player] then         for _, v in pairs(espDrawings[player]) do             pcall(function() v:Remove() end)         end         espDrawings[player] = nil     end end  for _, p in ipairs(Players:GetPlayers()) do     if p ~= LocalPlayer then createPlayerESP(p) end end Players.PlayerAdded:Connect(function(p)     if p ~= LocalPlayer then createPlayerESP(p) end end) Players.PlayerRemoving:Connect(removePlayerESP)  RunService.RenderStepped:Connect(function()     for player, drawings in pairs(espDrawings) do         local character = player.Character         local hrp = character and character:FindFirstChild("HumanoidRootPart")         local humanoid = character and character:FindFirstChildOfClass("Humanoid")                  local active = EggScriptConfig.ESP.PlayersEnabled and character and hrp and humanoid and humanoid.Health > 0         if active then             local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)             if onScreen then                 local head = character:FindFirstChild("Head")                 local rootPos = hrp.Position                 local topPos = head and head.Position + Vector3.new(0, 0.5, 0) or rootPos + Vector3.new(0, 2, 0)                 local legPos = rootPos - Vector3.new(0, 3, 0)                                  local topScreen = Camera:WorldToViewportPoint(topPos)                 local legScreen = Camera:WorldToViewportPoint(legPos)                 local height = math.abs(topScreen.Y - legScreen.Y)                 local width = height / 2                  if EggScriptConfig.ESP.Box then                     drawings.Box.Size = Vector2.new(width, height)                     drawings.Box.Position = Vector2.new(topScreen.X - width / 2, topScreen.Y)                     drawings.Box.Visible = true                 else                     drawings.Box.Visible = false                 end                  if EggScriptConfig.ESP.Name then                     drawings.Name.Text = player.Name                     drawings.Name.Position = Vector2.new(topScreen.X, topScreen.Y - 18)                     drawings.Name.Visible = true                 else                     drawings.Name.Visible = false                 end                  if EggScriptConfig.ESP.Tracer then                     drawings.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)                     drawings.Tracer.To = Vector2.new(topScreen.X, topScreen.Y + height)                     drawings.Tracer.Visible = true                 else                     drawings.Tracer.Visible = false                 end             else                 for _, v in pairs(drawings) do v.Visible = false end             end         else             for _, v in pairs(drawings) do v.Visible = false end         end     end end)  -- [[ Lógica do Anti-AFK ]] local antiAfkConnection local function setupAntiAFK()     if antiAfkConnection then antiAfkConnection:Disconnect() end     antiAfkConnection = LocalPlayer.Idled:Connect(function()         if EggScriptConfig.Settings.AntiAFKEnabled then             local vu = game:GetService("VirtualUser")             vu:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)             task.wait(1)             vu:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)         end     end) end setupAntiAFK()  -- [[ Lógica do Anti-Lag ]] local oldLightingProps = {} local function applyAntiLag(state)     if state then         oldLightingProps.GlobalShadows = Lighting.GlobalShadows         oldLightingProps.FogEnd = Lighting.FogEnd         Lighting.GlobalShadows = false         Lighting.FogEnd = 999999         for _, obj in ipairs(workspace:GetDescendants()) do             if obj:IsA("BasePart") then                 obj.Material = Enum.Material.SmoothPlastic                 obj.Reflectance = 0             elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") then                 obj.Enabled = false             end         end     else         if oldLightingProps.GlobalShadows ~= nil then             Lighting.GlobalShadows = oldLightingProps.GlobalShadows         end         if oldLightingProps.FogEnd ~= nil then             Lighting.FogEnd = oldLightingProps.FogEnd         end     end end  -- [[ Lógica Completa do Auto Farm (Sincronizada, Corrigida e com suporte ao Titan Temple) ]] local activeTween = nil local RETURN = Vector3.new(547, 71, -345) local RAY_DIST = 2000 local RAY_START = 1000 local ws = 0 local wsd = 0 local curHuman = nil local wsLoop = nil local wsChar = nil local farmBtnRef = nil  local function updateFarmButtonUI()     if not farmBtnRef then return end     if EggScriptConfig.AutoFarm.Active then         farmBtnRef.BackgroundColor3 = Color3.fromRGB(60, 200, 100)         farmBtnRef.Text = "ON"     else         farmBtnRef.BackgroundColor3 = Color3.fromRGB(60, 60, 75)         farmBtnRef.Text = "OFF"     end end  local function cancelTween()     if activeTween then         activeTween:Cancel()         activeTween = nil     end end  local function stopMove()     if curHuman then         local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")         if hrp then curHuman:MoveTo(hrp.Position) end     end end  local function setupWS()     local char = LocalPlayer.Character     if not char then return end     local hum = char:FindFirstChildOfClass("Humanoid")     if not hum then return end     if ws == 0 then         ws = hum.WalkSpeed         wsd = ws + 10     end     if wsLoop then wsLoop:Disconnect() wsLoop = nil end     if wsChar then wsChar:Disconnect() wsChar = nil end          local function onChange()         if EggScriptConfig.AutoFarm.Active and hum and hum.Parent then hum.WalkSpeed = wsd         elseif not EggScriptConfig.AutoFarm.Active and hum and hum.Parent then hum.WalkSpeed = ws end     end          onChange()     wsLoop = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(onChange)     wsChar = LocalPlayer.CharacterAdded:Connect(function(nChar)         local nh = nChar:WaitForChild("Humanoid")         if nh then             hum = nh             if ws == 0 then                 ws = hum.WalkSpeed                 wsd = ws + 10             end             onChange()             if wsLoop then wsLoop:Disconnect() end             wsLoop = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(onChange)         end     end) end  local function toggleAutoFarmState()     EggScriptConfig.AutoFarm.Active = not EggScriptConfig.AutoFarm.Active     if not EggScriptConfig.AutoFarm.Active then         cancelTween()         stopMove()         if wsLoop then wsLoop:Disconnect() wsLoop = nil end         if wsChar then wsChar:Disconnect() wsChar = nil end         local char = LocalPlayer.Character         if char then             local hum = char:FindFirstChildOfClass("Humanoid")             if hum then hum.WalkSpeed = ws end         end     else         setupWS()     end     updateFarmButtonUI() end  UserInputService.InputBegan:Connect(function(input, processed)     if processed then return end     if input.KeyCode == Enum.KeyCode.F then toggleAutoFarmState() end end)  LocalPlayer.CharacterAdded:Connect(function(char)     cancelTween()     ws = 0     wsd = 0     local hum = char:WaitForChild("Humanoid", 10)     curHuman = hum     if hum then hum.Died:Connect(cancelTween) end     task.wait(0.5)     if EggScriptConfig.AutoFarm.Active then setupWS() end end) if LocalPlayer.Character then     local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")     curHuman = hum     if hum then hum.Died:Connect(cancelTween) end end  local function getRoot()     local char = LocalPlayer.Character     if not char then return nil, nil end     local hum = char:FindFirstChildOfClass("Humanoid")     local hrp = char:FindFirstChild("HumanoidRootPart")     if not hum or hum.Health <= 0 or not hrp then return nil, nil end     return char, hrp end  local function getPos(obj)     if obj:IsA("BasePart") then return obj.Position end     if obj:IsA("Model") then return obj:GetPivot().Position end     if obj:IsA("Attachment") then return obj.WorldPosition end     return nil end  local function parseSpd(val)     if typeof(val) == "number" then return val end     local txt = tostring(val):lower():gsub(",", ""):gsub("%s+", "")     local num, suf = txt:match("^([%d%.]+)([kmb]?)$")     num = tonumber(num)     if not num then return 0 end     if suf == "k" then return num * 1000 end     if suf == "m" then return num * 1000000 end     if suf == "b" then return num * 1000000000 end     return num end  local function getPlayerSpd()     local ls = LocalPlayer:FindFirstChild("leaderstats")     if not ls then return 0 end     local stat = ls:FindFirstChild("Speed")     if not stat then return 0 end     return parseSpd(stat.Value) end  local function getGuardAreas()     local objs = workspace:FindFirstChild("__OBJECTS")     if not objs then return nil end     local areas = objs:FindFirstChild("Areas")     if not areas then return nil end     return areas:FindFirstChild("GuardAreas") end  local function inArea(pos, area)     local cf, size = area:GetBoundingBox()     local lp = cf:PointToObjectSpace(pos)     return math.abs(lp.X) <= size.X/2 and math.abs(lp.Y) <= size.Y/2 and math.abs(lp.Z) <= size.Z/2 end  local function getAreaAt(pos)     local areas = getGuardAreas()     if not areas then return nil end     for _, area in ipairs(areas:GetChildren()) do         if area:IsA("Model") and inArea(pos, area) then return area end     end     return nil end  local function getAreaReq(area)     if not area then return nil end     local sign = area:FindFirstChild("RequiredSpeedSign")     local main = sign and sign:FindFirstChild("Main")     local sg = main and main:FindFirstChild("SurfaceGui")     local req = sg and sg:FindFirstChild("Required")     local spd = req and req:FindFirstChild("Speed")     if not spd then return nil end     if spd:IsA("ValueBase") then return parseSpd(spd.Value) end     if spd:IsA("TextLabel") or spd:IsA("TextBox") then return parseSpd(spd.Text) end     return nil end  local function getEggSize(egg)     if egg:IsA("Model") then         local s = egg:GetExtentsSize()         return s.X * s.Y * s.Z     end     if egg:IsA("BasePart") then         local s = egg.Size         return s.X * s.Y * s.Z     end     return 0 end  -- Lista dinâmica de áreas disponíveis para o seletor (Inclui Titan Temple) local function getAvailableAreasList()     local list = {"Automático (Melhor Área)"}     local areas = getGuardAreas()     if areas then         for _, area in ipairs(areas:GetChildren()) do             if area:IsA("Model") then                 table.insert(list, area.Name)             end         end     end     return list end  -- Seletor Atualizado com suporte ao Titan Temple local function getBestEgg()     local pSpd = getPlayerSpd()     local bestReq = -math.huge     local bestEggs = {}          local foldersToCheck = {         workspace:FindFirstChild("AreaEggSlotsClient"),         workspace:FindFirstChild("Eggs"),         workspace:FindFirstChild("__OBJECTS") and workspace.__OBJECTS:FindFirstChild("Eggs")     }          for _, folder in ipairs(foldersToCheck) do         if folder then             for _, egg in ipairs(folder:GetDescendants()) do                 if egg:IsA("Model") or egg:IsA("BasePart") then                     local ePos = getPos(egg)                     if ePos then                         local area = getAreaAt(ePos)                         local areaName = area and area.Name or ""                         local req = getAreaReq(area) or 0                                                  -- Se o usuário selecionou uma área específica no menu                         local selected = EggScriptConfig.AutoFarm.SelectedArea                         local matchArea = (selected == "Automático (Melhor Área)" or areaName == selected)                                                  if pSpd >= req and matchArea then                             if req > bestReq then                                 bestReq = req                                 table.clear(bestEggs)                                 table.insert(bestEggs, egg)                             elseif req == bestReq then                                 table.insert(bestEggs, egg)                             end                         end                     end                 end             end         end     end          -- Varredura específica para o Titan Temple (caso utilize a estrutura exata de Nests / EggSpotBottom)     local guardAreas = getGuardAreas()     if guardAreas then         local titanTemple = guardAreas:FindFirstChild("Titan Temple")         if titanTemple then             local req = getAreaReq(titanTemple) or 0             local selected = EggScriptConfig.AutoFarm.SelectedArea             local matchArea = (selected == "Automático (Melhor Área)" or selected == "Titan Temple")                          if pSpd >= req and matchArea then                 local nests = titanTemple:FindFirstChild("Nests")                 if nests then                     for _, nestIndex in ipairs({2, 3, 4}) do                         local nest = nests:GetChildren()[nestIndex]                         if nest then                             local eggSpot = nest:FindFirstChild("EggSpotBottom")                             if eggSpot then                                 if req > bestReq then                                     bestReq = req                                     table.clear(bestEggs)                                     table.insert(bestEggs, eggSpot)                                 elseif req == bestReq then                                     table.insert(bestEggs, eggSpot)                                 end                             end                         end                     end                 end             end         end     end          if #bestEggs == 0 then         if EggScriptConfig.AutoFarm.SelectedArea ~= "Automático (Melhor Área)" then             EggScriptConfig.AutoFarm.SelectedArea = "Automático (Melhor Área)"             notify("Auto Farm", "Área selecionada indisponível. Voltando para modo Automático.")             return getBestEgg()         end         return nil     end          local biggest = nil     local biggestSize = -math.huge     for _, egg in ipairs(bestEggs) do         local s = getEggSize(egg)         if s > biggestSize then             biggestSize = s             biggest = egg         end     end     return biggest end  local function getClosestPrompt(pos)     local closest = nil     local closestDist = math.huge     for _, obj in ipairs(workspace:GetDescendants()) do         if obj.Name == "SmartPromptPart" and obj:IsA("BasePart") then             local d = (obj.Position - pos).Magnitude             if d < closestDist then                 closestDist = d                 closest = obj             end         end     end     return closest end  local function getPrompt(part)     if not part then return nil end     return part:FindFirstChildWhichIsA("ProximityPrompt", true) end  local function raycastGround(origin, char)     local ignored = { char }     for _ = 1, 25 do         local params = RaycastParams.new()         params.FilterType = Enum.RaycastFilterType.Exclude         params.FilterDescendantsInstances = ignored         params.IgnoreWater = true         local result = workspace:Raycast(origin, Vector3.new(0, -RAY_DIST, 0), params)         if not result then return nil end         local hit = result.Instance         if hit == workspace.Terrain or (hit:IsA("BasePart") and hit.CanCollide) then             return result         end         table.insert(ignored, hit)     end     return nil end  local function getGroundPos(hrp, reqPos, char)     local curGround = raycastGround(hrp.Position, char)     if not curGround then return nil end     local rootToFloor = math.clamp(hrp.Position.Y - curGround.Position.Y, 2, 6)     local origin = Vector3.new(reqPos.X, math.max(reqPos.Y, hrp.Position.Y) + RAY_START, reqPos.Z)     local destGround = raycastGround(origin, char)     if not destGround then return nil end     return destGround.Position + Vector3.new(0, rootToFloor + 0.05, 0) end  local function getDur(dist)     local dur = 5 + (dist * 0.00343)     if dur < 0.5 then dur = 0.5 end     if dur > 40 then dur = 40 end     return dur end  task.spawn(function()     while true do         task.wait(0.1)         if not EggScriptConfig.AutoFarm.Active then continue end         local char, hrp = getRoot()         if not char or not hrp then continue end         local egg = getBestEgg()         if not egg then task.wait(1) continue end         local eggPos = getPos(egg)         if not eggPos then continue end                  local stagePos = getGroundPos(hrp, RETURN, char)         if stagePos then             local t = TweenService:Create(hrp, TweenInfo.new(0.5, Enum.EasingStyle.Linear), {CFrame = CFrame.new(stagePos)})             activeTween = t             t:Play()             t.Completed:Wait()             if activeTween == t then activeTween = nil end         end                  if not EggScriptConfig.AutoFarm.Active then continue end                  loc